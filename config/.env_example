DEEPSEEK_API_KEY=your_api_key
KIMI_API_KEY=your_api_key

DB_URL=postgresql://user:password@localhost:5432/mybot

# 和风天气实时天气（https://dev.qweather.com/docs/configuration/authentication/）
# JWT 凭据：kid 在控制台凭据页查看，项目ID 在项目管理页查看，开发者ID 在设置页查看（Q 开头）
QWEATHER_API_HOST=https://your-api-host.qweatherapi.com
QWEATHER_KEY_ID=your_credential_id
QWEATHER_PROJECT_ID=your_project_id
QWEATHER_DEVELOPER_ID=Qyour_developer_id
# Ed25519 私钥：填文件路径（相对路径以项目根目录为基准）或直接填 PEM 内容
QWEATHER_PRIVATE_KEY_PATH=config/ed25519-private.pem
QWEATHER_PRIVATE_KEY=
# 查询位置（十进制，最多两位小数）与语言
QWEATHER_LATITUDE=39.92
QWEATHER_LONGITUDE=116.41
QWEATHER_LANG=zh
# 实时天气缓存秒数（默认 1200）
QWEATHER_CACHE_TTL=1200

# 本机 API 服务（python -m server）
MYBOT_API_PORT=8765
MYBOT_API_DB_TIMEOUT=5
MYBOT_MEMORY_SCHEMA=public
MYBOT_API_RUNS=1
MYBOT_API_MEMORY_WORKER=1

# TTS 权重路径（仅生成语音时加载）
TTS_MODEL_TYPE=voice_design
Qwen3_TTS_12Hz_1_7B-VoiceDesign=D:\models\Qwen3-TTS-12Hz-1.7B-VoiceDesign

BGEV2M3_RERANKER_PATH=D:\models\bge-reranker-v2-m3
QWEN3_RERANKER_PATH=D:\models\Qwen3-Reranker-0.6B
QWEN3_4BRERANKER_PATH=D:\models\Qwen3-Reranker-4B
QWEN3_EMBEDDING_PATH=D:\models\Qwen3-Embedding-0.6B
QWEN3_4BEMBEDDING_PATH=D:\models\Qwen3-Embedding-4B

DEFAULT_STORE_DIR=data/vectorstore
DEFAULT_KNOWLEDGE_COLLECTION_NAME=qq_bot_knowledge
DEFAULT_DOWNLOAD_DIR=data/downloads

MINIMUM_ITERATIONS=2
MAXIMUM_ITERATIONS=5
MEMORY_TOKEN_THRESHOLD=20000

# 模型输入上下文上限，与长期记忆开关独立；完整聊天历史仍保留。
MODEL_CONTEXT_TOKEN_BUDGET=16000
